[SERVICE]
    flush        1
    log_level    warn
    parsers_file /fluent-bit/etc/parsers.conf
    storage.path /fluent-bit/buffer
    # Espera máxima entre retentativas (padrão 2000 s)
    scheduler.cap 60

[INPUT]
    name         forward
    listen       0.0.0.0
    port         24224
    storage.type filesystem

[INPUT]
    name            fluentbit_metrics
    tag             internal_metrics
    scrape_interval 15

[FILTER]
    name         parser
    match        *
    key_name     log
    parser       json
    reserve_data on

[FILTER]
    name   record_modifier
    match  *
    record env production
    record host {{ inventory_hostname }}
    record origin container-logs

[FILTER]
    name  lua
    match *
    call  set_service
    code  function set_service(tag, ts, record) record["service"] = tag return 2, ts, record end

[OUTPUT]
    name        loki
    match       *
    host        {{ otel_endpoint_ip }}
    port        3500
    label_keys  $env,$origin,$service,$host
    line_format json
    retry_limit no_limits
    storage.total_limit_size 1G

[OUTPUT]
    name      prometheus_remote_write
    match     internal_metrics
    host      {{ otel_endpoint_ip }}
    port      9999
    uri       /api/v1/metrics/write
    add_label host {{ inventory_hostname }}
