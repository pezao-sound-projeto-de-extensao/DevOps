services:
  app1:
    image: {{ app_image }}
    container_name: app1
    restart: unless-stopped
    environment:
      - DB_HOST={{ db_host }}
      - DB_PORT={{ db_port }}
      - DB_NAME={{ db_name }}
      - DB_USERNAME={{ db_username }}
      - DB_PASSWORD={{ db_password }}
      - AWS_S3_BUCKET={{ s3 }}
      - JWT_SECRET={{ secret }}
      - CORS={{ cors }}
      - SPRING_PROFILES_ACTIVE=prod
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:8080/api/health > /dev/null || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 30
      start_period: 60s

  app2:
    image: {{ app_image }}
    container_name: app2
    restart: unless-stopped
    environment:
      - DB_HOST={{ db_host }}
      - DB_PORT={{ db_port }}
      - DB_NAME={{ db_name }}
      - DB_USERNAME={{ db_username }}
      - DB_PASSWORD={{ db_password }}
      - AWS_S3_BUCKET={{ s3 }}
      - JWT_SECRET={{ secret }}
      - CORS={{ cors }}
      - SPRING_PROFILES_ACTIVE=prod
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:8080/api/health > /dev/null || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 30
      start_period: 60s

  nginx:
    image: nginx:alpine
    container_name: nginx
    restart: unless-stopped
    depends_on:
      app1:
        condition: service_healthy
      app2:
        condition: service_healthy
    ports:
      - "80:80"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:80/api/health > /dev/null || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 30
      start_period: 60s
    volumes:
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro