x-fluentd: &fluentd
  fluentd-address: "127.0.0.1:24224"
  fluentd-async: "true"

x-back: &back
  placement:
    constraints:
      - node.role == manager

services:
  fluent-bit:
    image: fluent/fluent-bit:3.2
    ports:
      - target: 24224
        published: 24224
        mode: host
    volumes:
      - /opt/app/fluent-bit/fluent-bit.conf:/fluent-bit/etc/fluent-bit.conf:ro
      - fluent-bit-buffer:/fluent-bit/buffer
    deploy: *back

  rabbitmq:
    image: rabbitmq:3-alpine
    environment:
      RABBITMQ_DEFAULT_USER: {{ rabbitmq_username }}
      RABBITMQ_DEFAULT_PASS: {{ rabbitmq_password }}
    volumes:
      - rabbitmq-data:/var/lib/rabbitmq
    logging:
      driver: fluentd
      options:
        <<: *fluentd
        tag: rabbitmq
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "-q", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    deploy: *back

  app:
    image: {{ app_image }}
    env_file:
      - /opt/app/.env
    logging:
      driver: fluentd
      options:
        <<: *fluentd
        tag: app
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:8080/api/health > /dev/null || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 30
      start_period: 60s
    deploy:
      <<: *back
      replicas: 2

  nginx:
    image: nginx:alpine
    ports:
      - target: 80
        published: 80
        mode: host
    volumes:
      - /opt/app/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    logging:
      driver: fluentd
      options:
        <<: *fluentd
        tag: nginx
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:80/api/health > /dev/null || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 30
      start_period: 60s
    deploy: *back

  web:
    image: {{ web_image }}
    environment:
      VITE_API_BASE_URL: {{ alb_url }}
    ports:
      - target: 80
        published: 80
        mode: host
    healthcheck:
      test: ["CMD", "curl", "--fail", "http://localhost:80"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    deploy:
      placement:
        constraints:
          - node.role == worker

volumes:
  rabbitmq-data:
  fluent-bit-buffer:
